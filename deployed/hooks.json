{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __CODEX_CLEANUP_HOME__/hooks/posttooluse_exec_compact.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __CODEX_CLEANUP_HOME__/hooks/precompact_warn.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __CODEX_CLEANUP_HOME__/hooks/postcompact_compact.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
